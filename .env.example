# ─── Backend (backend/.env) ──────────────────────────────────────────────────

# Postgres connection strings (Supabase). DIRECT_URL bypasses the pooler for Alembic.
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# JWT signing. Generate a long random value per deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# bcrypt cost factor
BCRYPT_WORK_FACTOR=12

# Resend — transactional email (invites, vendor job offers)
RESEND_API_KEY=re_placeholder

# Public URL of the FRONTEND. Invite and job-offer emails link here, so it must
# be the Next.js origin (http://localhost:3000 in development), not the API's.
BASE_URL=http://localhost:3000

# Browser origins allowed to call the API, comma-separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# Supabase Storage — ticket photos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=placeholder-service-role-key
SUPABASE_STORAGE_BUCKET=tickets

# LangSmith tracing (required in every environment per the AI-layer conventions)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_placeholder
LANGSMITH_PROJECT=maintenance-dispatcher

# Upstash Redis — LangGraph checkpointer
REDIS_URL=rediss://default:password@host:6379

# OpenAI — agent LLM calls
OPENAI_API_KEY=sk-placeholder


# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────

# Base URL of the FastAPI backend. Exposed to the browser, so it must never hold
# a secret — it is only an address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
