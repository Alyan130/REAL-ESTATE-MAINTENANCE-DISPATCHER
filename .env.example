# ─── Backend (backend/.env) ──────────────────────────────────────────────────

# Postgres connection strings (Supabase). DIRECT_URL bypasses the pooler for Alembic.
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# JWT signing. Generate a long random value per deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# bcrypt cost factor
BCRYPT_WORK_FACTOR=12

# Resend — transactional email (invites, vendor job offers)
RESEND_API_KEY=re_placeholder

# Public URL of the FRONTEND. Invite and job-offer emails link here, so it must
# be the Next.js origin (http://localhost:3000 in development), not the API's.
BASE_URL=http://localhost:3000

# Browser origins allowed to call the API, comma-separated. Never "*".
CORS_ORIGINS=http://localhost:3000

# Supabase Storage — ticket photos
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=placeholder-service-role-key
SUPABASE_STORAGE_BUCKET=tickets

# LangSmith tracing (required in every environment per the AI-layer conventions)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_placeholder
LANGSMITH_PROJECT=maintenance-dispatcher

# Upstash Redis — LangGraph checkpointer
REDIS_URL=rediss://default:password@host:6379

# OpenAI — agent LLM calls
# Which provider the agents call. "openai" or "openrouter" — both speak the
# OpenAI wire format, so switching is a key and a base URL (see agentic_AI/llm.py).
LLM_PROVIDER=openai
# Model id in the selected provider's namespace.
#   openai     -> gpt-4o
#   openrouter -> google/gemma-3-27b-it, anthropic/claude-sonnet-4, ...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
# Leave blank for LangChain's default (function-calling). Set to "json_schema"
# for a model with no tool-calling support, or structured output comes back
# empty and Pydantic quietly fills it with defaults.
LLM_STRUCTURED_METHOD=

OPENAI_API_KEY=sk-placeholder

OPENROUTER_API_KEY=sk-or-v1-placeholder
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Inngest — durable timers for vendor follow-ups.
# Optional: with these unset the negotiation still works end to end, a vendor who
# never replies simply isn't chased. Local dev also needs the dev server running,
# or timers silently never fire:
#   npx inngest-cli@latest dev -u http://localhost:8000/api/inngest
INNGEST_APP_ID=dispatcher
INNGEST_EVENT_KEY=placeholder
INNGEST_SIGNING_KEY=signkey-placeholder
INNGEST_DEV=true


# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────

# Base URL of the FastAPI backend. Exposed to the browser, so it must never hold
# a secret — it is only an address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
